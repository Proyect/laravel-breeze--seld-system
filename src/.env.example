# Producción: APP_ENV=production, APP_DEBUG=false, APP_URL=https://..., LOG_LEVEL=error,
# SESSION_SECURE_COOKIE=true. Ver docs/DESPLIEGUE.md.
APP_NAME=Infrasoft
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contacto@infrasoft.com.ar"
MAIL_FROM_NAME="${APP_NAME}"

# Producción SMTP (descomentar y completar):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.tuservidor.com
# MAIL_PORT=587
# MAIL_USERNAME=tu_usuario
# MAIL_PASSWORD=tu_password
# MAIL_ENCRYPTION=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe (pagos internacionales — USD, EUR, etc.)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago (pagos en ARS)
# Credenciales de prueba: https://www.mercadopago.com.ar/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Token aleatorio largo (p. ej. `openssl rand -hex 32`); se agrega a notification_url
# y el webhook rechaza (403) notificaciones sin él.
MERCADOPAGO_NOTIFICATION_TOKEN=

# Horas que una venta pendiente reserva stock antes de liberarse (0 = nunca)
SALES_PENDING_TTL_HOURS=48

# Solo para `php artisan db:seed` en producción (crea el primer admin)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
